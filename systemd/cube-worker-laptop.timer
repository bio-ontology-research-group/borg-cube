# Pick up host:laptop requests promptly while the laptop is available.
[Unit]
Description=borg-cube laptop worker timer (every 5 minutes)
ConditionHost=lc-dell
ConditionPathExists=!%h/Public/software/borg-cube/state/KILL

[Timer]
OnCalendar=*:0/5
Persistent=true
Unit=cube-worker-laptop.service

[Install]
WantedBy=timers.target
