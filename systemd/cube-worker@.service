# Marshal worker loop. Instance = number of slots, e.g. cube-worker@3.service.
[Unit]
Description=borg-cube worker (marshal) with %i slots
Documentation=file:%h/Public/software/borg-cube/systemd/README.md
ConditionPathExists=!%h/Public/software/borg-cube/state/KILL
After=network-online.target

[Service]
# systemd user services have no login PATH; bd, uv, claude and codex live in ~/.local/bin.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Type=simple
WorkingDirectory=%h/Public/software/borg-cube
EnvironmentFile=-%h/Public/software/borg-cube/.env
# --loop: the unit is Type=simple and KillMode=mixed, so a one-tick worker exits
# and systemd kills the runs it just dispatched (seen on ws 2026-09-06). The
# loop syncs the ledger and dispatches every 5 minutes until state/KILL
# (Robert, 2026-09-07: 30 minutes with one plan slot starved 81 ready beads).
ExecStart=%h/Public/software/borg-cube/.venv/bin/cube worker --slots %i --loop --interval 300
Restart=on-failure
RestartSec=30
# process, not mixed: a restart or stop of the worker must not kill the runs it
# dispatched (they are its children); the leases patrol reaps the dead ones.
KillMode=process
TimeoutStopSec=120

[Install]
WantedBy=default.target
