[Unit]
Description=BORG Cube dependency-ready local research scheduler
ConditionPathExists=!%h/Public/software/borg-cube/state/KILL

[Service]
Type=oneshot
WorkingDirectory=%h/Public/software/borg-cube
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=CUBE_HOST=ws
ExecStart=%h/Public/software/borg-cube/.venv/bin/cube schedule --apply --json
TimeoutStartSec=250min
UMask=0077
Nice=10
