# Copy to .env (gitignored). Scoped, revocable tokens only. Never passwords.
CUBE_ROOT=~/Public/software/borg-cube
MATTERMOST_URL=https://borg.bio2vec.net
MATTERMOST_TOKEN=            # bot token for @borg-advisor (created in Phase 4)
MATTERMOST_CONCIERGE_TOKEN=  # bot token for the Robert-only concierge
GH_TOKEN=                    # fine-grained, read-only on bio-ontology-research-group
OPENROUTER_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1   # the group's own OpenAI-compatible endpoint
CUBE_SIGNATURE_PATH=         # outside the repo; used by the secretary only per request
CUBE_MM_OWNER_ID=              # Mattermost user id of the owner (the only person the concierge listens to)
CUBE_MM_DM_CHANNEL=            # Mattermost DM channel id between the owner and the Hermes bot
