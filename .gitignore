# agent runtime data: inboxes and memories are written by runs on the host
# where the agent lives; they never travel through git (Robert 2026-09-07)
agents/*/inbox.jsonl
agents/*/inbox.jsonl.lock
agents/*/memory/
# Beads passive exports; the ledger itself syncs through the Dolt remote
.beads/interactions.jsonl

# Site-specific data (Robert, 2026-09-13): the code is shareable, the group is not.
