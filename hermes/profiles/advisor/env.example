# ~/.hermes/profiles/advisor/.env on ws (mode 0600, gitignored, never seeded). Scoped tokens only, never passwords.
OPENROUTER_API_KEY=
VLLM_API_KEY=local                 # vLLM without --api-key accepts anything; keep non-empty
MATTERMOST_URL=https://borg.bio2vec.net
MATTERMOST_TOKEN=                  # bot token of @borg-advisor (created by the Mattermost sysadmin in Phase 4)
# MATTERMOST_ALLOWED_USERS is written into config.yaml by `cube hermes render` from contacts.yaml grants; do not set it here.
CUBE_ROOT=~/Public/software/borg-cube
